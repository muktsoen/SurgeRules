#!name=闲鱼去广告
#!desc=移除闲鱼广告（由 ccyykk666、ddgksf2013 的 Loon 插件移植而来，Surge 可用）
#!author=ccyykk666, ddgksf2013
# 来源：https://raw.githubusercontent.com/ccyykk666/Loon-Plugin/main/plugins/goofish/goofish_ad.lpx
# 更新时间：2026-10-26
# 说明：原插件无开关、无外挂脚本；18 条响应规则逐条翻成 Goofish-rewrite.js（jq/replace/delete 等价实现，
# 全部带原规则的 status 200 门禁），8 条请求规则翻成 Goofish-request.js（reject 与 reject_dict 区分对待）；
# [Rule] 的 iyes.youku.com 拦截是普通分流规则，模块可直接承载，原样保留。

[Rule]
DOMAIN-SUFFIX,iyes.youku.com,REJECT

[Script]
GF-rewrite = type=http-response,pattern=^https?://(?:g-)?acs\.m\.goofish\.com/gw/(?:mtop\.taobao\.idlecommerce\.splash\.async\.ads|mtop\.idle\.idleadv\.scene\.restore|mtop\.taobao\.idle\.user\.strategy\.list|mtop\.taobao\.idlehome\.home\.circle\.list|mtop\.taobao\.idlehome\.home\.nextfresh|mtop\.taobao\.idlehome\.widget\.refresh\.get|mtop\.taobao\.idlemtopsearch\.item\.search\.activate|mtop\.taobao\.idlemtopsearch\.search\.discover|mtop\.taobao\.idle\.item\.buy\.feeds|mtop\.taobao\.idle\.local\.home|mtop\.taobao\.idlemtopsearch\.search|mtop\.taobao\.idle\.item\.recommend|mtop\.taobao\.idlemtopsearch\.search\.shade|mtop\.taobao\.idlemtopsearch\.detailpage\.search\.shade|mtop\.taobao\.idlemtopsearch\.search\.activate\.tablist|mtop\.taobao\.idlemtopsearch\.search\.activate\.trendlist|mtop\.taobao\.idle\.user\.page\.my\.adapter|mtop\.taobao\.idle\.trade\.full\.info|mtop\.taobao\.idle\.awesome\.detail\.unit),requires-body=true,script-path=https://raw.githubusercontent.com/muktsoen/SurgeRules/main/Goofish-rewrite.js
GF-request = type=http-request,pattern=^https?://(?:g-)?acs\.m\.goofish\.com/gw/(?:mtop.*splash\.ads|mtop\.idle\.ad\.expose|mtop\.taobao\.idlemessage\.user\.query\.top\.resource|mtop\.taobao\.idle\.item\.resell\.recommendorhotcate|mtop\.taobao\.idle\.item\.resell\.channel|mtop\.taobao\.idle\.activity\.sell\.seller\.recommend|mtop\.taobao\.idle\.playboy\.recommend),script-path=https://raw.githubusercontent.com/muktsoen/SurgeRules/main/Goofish-request.js
GF-amdc = type=http-request,pattern=^http://[A-Za-z0-9_-]+(?:\.[A-Za-z0-9_-]+){1,4}(?::\d+)?/amdc/mobileDispatch/,script-path=https://raw.githubusercontent.com/muktsoen/SurgeRules/main/Goofish-request.js

[MITM]
hostname = %APPEND% acs.m.goofish.com, g-acs.m.goofish.com
