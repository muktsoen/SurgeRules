#!name=BlockHTTPDNS
#!desc=拦截常见 HTTPDNS 服务。合并自 QingRex Beta、VirgilClyne Official、blackmatrix7 三份，去重后每周一自动更新。
#!author=QingRex, VirgilClyne, blackmatrix7
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/Other_icon/120px/HTTPDNS.png

[General]
force-http-engine-hosts = %APPEND% 119.29.29.29:80, dns.weixin.qq.com:80, dns.weixin.qq.com:8080, dns.weixin.qq.com:443

[Rule]
DOMAIN-KEYWORD,httpdns,REJECT,extended-matching,pre-matching
DOMAIN-KEYWORD,httpsdns,REJECT,extended-matching,pre-matching
USER-AGENT,"httpdns*",REJECT
USER-AGENT,"Httpdns*",REJECT
USER-AGENT,"httpsdns*",REJECT
USER-AGENT,"Httpsdns*",REJECT
URL-REGEX,"^http:\/\/((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)(?:\/v?[0-9]+)?\/(?:sign_)?(?:(?:d|ss)[46]?|resolve)\?",REJECT,extended-matching
URL-REGEX,"^http:\/\/((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?):\d+\/httpdns\/",REJECT,extended-matching
URL-REGEX,"^http:\/\/103\.37\.155\.60\/fetch",REJECT,extended-matching
URL-REGEX,"^http:\/\/103\.41\.167\.237\/v2\/resolv",REJECT,extended-matching
URL-REGEX,"^http:\/\/103\.44\.58\.64\/md\?",REJECT,extended-matching
URL-REGEX,"^http:\/\/\[[0-9a-fA-F:]+\](?:\/v?[0-9]+)?\/(?:sign_)?(?:(?:d|ss)[46]?|resolve)\?",REJECT,extended-matching
URL-REGEX,"^http:\/\/\[[0-9a-fA-F:]+\]:\d+\/httpdns\/",REJECT,extended-matching
URL-REGEX,"^http:\/\/api\.weibo\.cn\/\d+\/httpdns\/config",REJECT,extended-matching
URL-REGEX,"^http:\/\/api\.weibo\.cn\/httpdns\/config",REJECT,extended-matching
URL-REGEX,"^http:\/\/cdn\.wup\.huya\.com\/launch\/queryHttpDns",REJECT,extended-matching
URL-REGEX,"^http:\/\/xmc\.ximalaya\.com\/xmlymain-login-web\/login\/",REJECT,extended-matching
