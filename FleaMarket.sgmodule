#!name=闲鱼去广告
#!desc=移除开屏广告、商品信息流广告、搜索栏填充词、我的页面推广横幅（由可莉、ZenMoFiShi、RuCu6 的 Loon 插件移植而来，Surge 可用）
#!author=可莉, ZenMoFiShi, RuCu6
# 来源（GitHub 镜像，因 kelee.one 站点被 Cloudflare 拦截无法直取）：
# https://raw.githubusercontent.com/axtyet/Luminous/main/KeLee/Tool/Loon/Plugin/FleaMarket_remove_ads.plugin（2024-10-19）
# 说明：与 ccyykk666 的 Goofish 版不同，这版带专用脚本做模板级深度过滤（首页信息流、搜索 AliMaMaAD、我的页横幅/工具箱），
# 另有 10 个接口直接 reject。移植时三处与原插件不同，均有原因：
#   1. 搜索脚本行原 pattern 为 g-(g-)?acs（疑似笔误），改成 (g-)?acs，否则匹配不到 acs 主域名。
#   2. URL Rewrite 的 acs 规则补了 (g-)?，与 MITM 的两个域名对齐。
#   3. h5.m.goofish.com 加进 MITM，否则 moyu 那条 URL Rewrite 看不到 path、等于死规则。
# 注意：不要与 Goofish.sgmodule 同时安装，两者覆盖的接口有重叠，响应脚本先匹配的胜出、另一份的清理会丢。

[Rule]
AND,((URL-REGEX,^http://amdc\.m\.taobao\.com/amdc/mobileDispatch),(USER-AGENT,%E9%97%B2%E9%B1%BC*)),REJECT

[URL Rewrite]
^https://(?:g-)?acs\.m\.goofish\.com/gw/mtop\.taobao\.idle\.home\.whale\.modulet/ reject-dict
^https://(?:g-)?acs\.m\.goofish\.com/gw/mtop\.taobao\.idle\.item\.recommend\.list/ reject-dict
^https://(?:g-)?acs\.m\.goofish\.com/gw/mtop\.taobao\.idle\.item\.resell\.recommendorhotcate/ reject-dict
^https://(?:g-)?acs\.m\.goofish\.com/gw/mtop\.taobao\.idle\.playboy\.recommend/ reject-dict
^https://(?:g-)?acs\.m\.goofish\.com/gw/mtop\.taobao\.idle\.topic\.banner/ reject-dict
^https://(?:g-)?acs\.m\.goofish\.com/gw/mtop\.taobao\.idle\.user\.strategy\.list/ reject-dict
^https://(?:g-)?acs\.m\.goofish\.com/gw/mtop\.taobao\.idlehome\.idle\.coin\.nextfresh/ reject-dict
^https://(?:g-)?acs\.m\.goofish\.com/gw/mtop\.taobao\.idlemtopsearch\.search\.discover/ reject-dict
^https://(?:g-)?acs\.m\.goofish\.com/gw/mtop\.taobao\.idlemtopsearch\.search\.shade/ reject-dict
^https://(?:g-)?acs\.m\.goofish\.com/gw/mtop\.taobao\.idlemtopsearch\.item\.search\.activate/ reject-dict
^https://h5\.m\.goofish\.com/wow/moyu/moyu-project/[\w-]*search[\w-]*/pages/ reject-200

[Script]
FM-myadapter = type=http-response,pattern=^https://(?:g-)?acs\.m\.goofish\.com/gw/mtop\.idle\.user\.page\.my\.adapter/,requires-body=true,script-path=https://raw.githubusercontent.com/muktsoen/SurgeRules/main/FleaMarket.js
FM-nextfresh = type=http-response,pattern=^https://(?:g-)?acs\.m\.goofish\.com/gw/mtop\.taobao\.idlehome\.home\.nextfresh/,requires-body=true,script-path=https://raw.githubusercontent.com/muktsoen/SurgeRules/main/FleaMarket.js
FM-circlelist = type=http-response,pattern=^https://(?:g-)?acs\.m\.goofish\.com/gw/mtop\.taobao\.idlehome\.home\.circle\.list/,requires-body=true,script-path=https://raw.githubusercontent.com/muktsoen/SurgeRules/main/FleaMarket.js
FM-search = type=http-response,pattern=^https://(?:g-)?acs\.m\.goofish\.com/gw/mtop\.taobao\.idlemtopsearch\.search/,requires-body=true,script-path=https://raw.githubusercontent.com/muktsoen/SurgeRules/main/FleaMarket.js

[MITM]
hostname = %APPEND% acs.m.goofish.com, g-acs.m.goofish.com, h5.m.goofish.com
