#!name=闲鱼去广告
#!desc=移除开屏广告、商品信息流广告、关注推荐、搜索栏填充词、首页签到入口及悬浮广告，精简我的页面（由可莉的 Loon 插件移植而来，Surge 可用）
#!author=可莉
# 来源（现网版，2026-10-02，经 VPS2 自部署 Script Hub 代取）：https://kelee.one/Tool/Loon/Lpx/FleaMarket_remove_ads.lpx
# 更新时间：2026-10-27
# 说明：现网版纯 Rewrite 规则（无外挂脚本、无分流规则），24 条全转：7 条请求 reject_dict 进请求脚本，
# 17 条响应 jq/delete 进响应脚本。搜索两条规则原插件只写 g-acs 域名，单独一行 pattern 限定。
# 注意：不要与 Goofish.sgmodule 同时安装，两者覆盖的接口有重叠，响应脚本先匹配的胜出、另一份的清理会丢。

[Script]
FM-request = type=http-request,pattern=^https://acs\.m\.goofish\.com/gw/(?:mtop\.taobao\.idlecommerce\.splash\.ads|mtop\.taobao\.idle\.user\.strategy\.list|mtop\.taobao\.idle\.item\.recommend\.list|mtop\.taobao\.idle\.local\.near\.by\.corner\.info|mtop\.taobao\.idle\.item\.buy\.feeds|mtop\.taobao\.idlemtopsearch\.search\.shade|mtop\.taobao\.idle\.playboy\.recommend)/,script-path=https://raw.githubusercontent.com/muktsoen/SurgeRules/main/FleaMarket-request.js
FM-rewrite = type=http-response,pattern=^https://acs\.m\.goofish\.com/gw/(?:mtop\.taobao\.idlehome\.home\.nextfresh|mtop\.taobao\.idlehome\.widget\.refresh\.get|mtop\.taobao\.idle\.home\.whale\.modulet|mtop\.taobao\.idle\.fun\.follow\.feed\.list|mtop\.taobao\.idlehome\.home\.community|mtop\.taobao\.idlehome\.home\.newitem\.page|mtop\.taobao\.idle\.local\.flow\.plat\.section|mtop\.taobao\.idle\.local\.home\.top|mtop\.taobao\.idle\.local\.home|mtop\.idle\.user\.page\.my\.adapter|mtop\.taobao\.idlehome\.home\.circle\.list|mtop\.taobao\.idlehome\.magic\.home\.page\.list|mtop\.taobao\.idlemtopsearch\.search\.discover|mtop\.taobao\.idlemtopsearch\.item\.search\.activate|mtop\.taobao\.idle\.trade\.full\.info)/,requires-body=true,script-path=https://raw.githubusercontent.com/muktsoen/SurgeRules/main/FleaMarket.js
FM-search = type=http-response,pattern=^https://g-acs\.m\.goofish\.com/gw/mtop\.taobao\.idlemtopsearch\.search/,requires-body=true,script-path=https://raw.githubusercontent.com/muktsoen/SurgeRules/main/FleaMarket.js

[MITM]
hostname = %APPEND% acs.m.goofish.com, g-acs.m.goofish.com
